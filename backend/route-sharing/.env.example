
DB_URL=jdbc:postgresql://localhost:5432/route_sharing
DB_USERNAME=postgres
DB_PASSWORD=change-me

JWT_BASE64_SECRET=replace-with-a-strong-base64-secret
GOONG_API_KEY=replace-with-your-goong-api-key
GOONG_BASE_URL=https://rsapi.goong.io
GOONG_DIRECTIONS_PATH=/v2/direction

FRONTEND_ORIGIN=http://localhost:5173
APPLICATION_ORIGIN=http://localhost:8080
INTERNAL_PORTAL_AUTHORITY=ACCESS_INTERNAL_PORTAL
FORWARD_HEADERS_STRATEGY=none

# E5-03 boarding credential AES key (Base64 of 16/24/32 random bytes)
BOARDING_CODE_ACTIVE_KEY_VERSION=v1
BOARDING_CODE_KEY_BASE64=
